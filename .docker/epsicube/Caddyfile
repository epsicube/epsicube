{
        skip_install_trust

        {$CADDY_GLOBAL_OPTIONS}

        frankenphp {
                {$FRANKENPHP_CONFIG}
        }
}

{$CADDY_EXTRA_CONFIG}

{$SERVER_NAME:localhost} {
        log {
               # Redact the authorization query parameter that can be set by Mercure
               format filter {
                       request>uri query {
                               replace authorization REDACTED
                       }
               }
        }

        route {
                root * "{$SERVER_ROOT:public/}"
                encode zstd br gzip

                # Uncomment the following lines to enable Mercure and Vulcain modules
                mercure {
                       issuer {$MERCURE_TRUSTED_ISSUERS:http://localhost} {
                              publisher {
                                     jwt {env.MERCURE_JWT_SECRET} HS256
                              }
                              subscriber {
                                     jwt {env.MERCURE_JWT_SECRET} HS256
                              }
                       }
                       resource_identifier {$MERCURE_PUBLIC_URL:http://localhost/.well-known/mercure}
                       anonymous
                       subscriptions
                       cookie_name {$MERCURE_COOKIE_NAME:__Secure-mercure_access_token}
                       {$MERCURE_EXTRA_DIRECTIVES}
                }
                #vulcain

                {$CADDY_SERVER_EXTRA_DIRECTIVES}

                @static {
                        file
                        path *.js *.css *.jpg *.jpeg *.gif *.png *.ico *.cur *.gz *.svg *.svgz *.mp4 *.mp3 *.ogg *.ogv *.webm *.htc *.woff2 *.woff
                }
                header @static Cache-Control "public, immutable, stale-while-revalidate=86400, max-age=31536000"

                header {
                    -Server
                    -X-Powered-By
                }

                @rejected {
                        file
                        expression `path('*.bak', '*.conf', '*.dist', '*.fla', '*.ini', '*.inc', '*.inci', '*.log', '*.orig', '*.psd', '*.sh', '*.sql', '*.swo', '*.swp', '*.swop', '*/.*') && !path('*/.well-known/')`
                }
                error @rejected 401

                php_server {
                        try_files {path} /index.php
                        resolve_root_symlink
                }
        }
}

# Custom healthcheck endpoint, or tls on_demand issuing (internal)
:2020 {
    root * "{$SERVER_ROOT:public/}"
    request_header Host epsicube.internal
    php_server {
            try_files {path} /index.php
            resolve_root_symlink
    }
}


import Caddyfile.d/*.caddyfile
